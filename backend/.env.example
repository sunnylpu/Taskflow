# Environment Variables — TaskFlow Backend
# Copy this file to .env and fill in the values

# ─── Database ───────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://taskflow_user:taskflow_pass@localhost:5432/taskflow_db"

# ─── JWT ─────────────────────────────────────────────────────────────────────
# REQUIRED: Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# JWT expiry duration (e.g. 7d, 1h, 30m)
JWT_EXPIRES_IN=7d

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── CORS ────────────────────────────────────────────────────────────────────
ALLOWED_ORIGIN=http://localhost:5173
